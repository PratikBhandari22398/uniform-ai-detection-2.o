<%- include("../includes/boiler.ejs") %>
<%- include("../includes/nav.ejs") %>

<style>
  :root {
    --bg: #05060f;
    --card: rgba(255, 255, 255, 0.04);
    --border: rgba(255, 255, 255, 0.1);
    --text: #ffffff;
    --muted: #94a3b8;
    --accent: #3b82f6;
    --success: #00ff88;
    --danger: #ff4d4d;
    --accent-glow: rgba(59, 130, 246, 0.3);
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
  }

  .profile-page {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 20px 60px;
  }

  /* HEADER / INFO */
  .profile-header {
    background: var(--card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 30px;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 30px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  .avatar-lg {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, var(--accent), #1e40af);
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    font-weight: 800;
    color: #fff;
    box-shadow: 0 10px 25px var(--accent-glow);
  }

  .user-meta h1 { 
    margin: 0; 
    font-size: 32px; 
    font-weight: 900; 
    letter-spacing: -1px;
  }

  .user-meta p {
    margin: 8px 0 0;
    color: var(--muted);
    font-weight: 500;
    font-size: 15px;
    display: flex;
    gap: 15px;
  }

  .user-meta span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* STATS CARDS */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }

  .stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 24px;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .stat-card:hover { transform: translateY(-5px); }
  
  .stat-card h3 {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
    padding-bottom: 10px;
  }

  .stat-card .val {
    font-size: 30px;
    font-weight: 900;
  }

  /* COMPLIANCE PROGRESS */
  .compliance-box {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 30px;
    margin-bottom: 30px;
  }

  .compliance-box h2 {
    margin: 0 0 20px;
    font-size: 20px;
    font-weight: 800;
  }

  .progress-container {
    height: 14px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border);
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--success));
    box-shadow: 0 0 15px var(--accent-glow);
    border-radius: 999px;
    transition: width 1s ease-in-out;
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
    font-weight: 700;
    font-size: 14px;
  }

  /* HISTORY TABLE */
  .history-section {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 30px;
  }

  .history-section h2 {
    margin: 0 0 20px;
    font-size: 20px;
    font-weight: 800;
  }

  .table-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .table-item:last-child { border-bottom: none; }

  .status-tag {
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .tag-ok { background: rgba(0, 255, 136, 0.1); color: var(--success); border: 1px solid rgba(0, 255, 136, 0.2); }
  .tag-bad { background: rgba(255, 77, 77, 0.1); color: var(--danger); border: 1px solid rgba(255, 77, 77, 0.2); }

  @media (max-width: 850px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .profile-header { flex-direction: column; text-align: center; }
    .avatar-lg { margin: 0 auto; }
  }
</style>

<div class="profile-page">
  <div class="profile-header">
    <div class="avatar-lg"><%= user.username.charAt(0).toUpperCase() %></div>
    <div class="user-meta">
      <h1><%= user.username %></h1>
      <p>
        <span><i class="fa-solid fa-building-user"></i> <%= user.department %></span>
        <span><i class="fa-solid fa-graduation-cap"></i> Year <%= user.year %></span>
        <span><i class="fa-solid fa-users-rectangle"></i> Div <%= user.division %></span>
      </p>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-card">
      <h3>Total Scans</h3>
      <div class="val" style="color: var(--accent);"><%= total %></div>
    </div>
    <div class="stat-card">
      <h3>Compliant</h3>
      <div class="val" style="color: var(--success);"><%= compliant %></div>
    </div>
    <div class="stat-card">
      <h3>Violations</h3>
      <div class="val" style="color: var(--danger);"><%= nonCompliant %></div>
    </div>
    <div class="stat-card">
      <h3>Compliance Rate</h3>
      <div class="val" style="color: #fff;"><%= percentage %>%</div>
    </div>
  </div>

  <div class="compliance-box">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="margin:0;">Profile Completion & Compliance</h2>
      <span style="font-weight: 900; font-size: 24px; color: var(--accent);"><%= percentage %>%</span>
    </div>
    <div class="progress-container">
      <div class="progress-bar" style="width: <%= percentage %>%"></div>
    </div>
    <div class="progress-info">
      <span style="color: var(--muted);">Low Score</span>
      <span style="color: var(--success);">Perfect Score</span>
    </div>
  </div>

  <div class="history-section">
    <h2>Recent Detection History</h2>
    <% if (history && history.length > 0) { %>
      <% history.forEach(item => { %>
        <div class="table-item">
          <div>
            <div style="font-weight: 800; font-size: 15px;">AI Scanning • <%= item.label || 'Detection' %></div>
            <div style="color: var(--muted); font-size: 13px; margin-top: 4px;"><%= new Date(item.createdAt).toLocaleString() %></div>
          </div>
          <div style="display: flex; align-items: center; gap: 20px;">
            <div style="font-weight: 700; color: var(--muted); font-size: 13px;">Conf: <%= Math.round(item.confidence * 100) %>%</div>
            <div class="status-tag <%= item.isCompliant ? 'tag-ok' : 'tag-bad' %>">
              <%= item.isCompliant ? 'Compliant' : 'Violation' %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align: center; color: var(--muted); padding: 20px;">No scan history found.</div>
    <% } %>
  </div>
</div>

<%- include("../includes/footer.ejs") %>
