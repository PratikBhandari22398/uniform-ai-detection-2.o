<style>
  .navbar-custom {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    padding: 0 40px;
    width: 100%;
    background: rgba(2, 6, 23, 0.7);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.25);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    box-sizing: border-box;
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-area img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
    border: 1px solid rgba(59, 130, 246, 0.2);
  }

  .logo-area a {
    text-decoration: none;
  }

  .logo-text {
    font-size: 1.6rem;
    font-weight: 800;
    color: #e5e7eb;
    font-family: "Space Grotesk", system-ui, sans-serif;
    letter-spacing: .04em;
  }

  .pro-text {
    color: var(--accent);
    font-weight: 900;
  }

  .right-buttons {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .right-buttons a,
  .right-buttons button {
    margin-left: 20px;
    font-size: .95rem;
    font-weight: 600;
    text-decoration: none;
    padding: 9px 22px;
    border-radius: 999px;
    transition: .25s ease;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav-link-custom {
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    margin-left: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link-custom:hover {
    color: #fff; /* White text on hover */
    background: rgba(59, 130, 246, 0.15); /* Slightly clearer blue tint */
    transform: translateY(-2px);
    text-shadow: 0 0 12px rgba(59, 130, 246, 0.8); /* Attractive Blue Text Glow */
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3), 0 0 30px rgba(59, 130, 246, 0.1);
  }

  .btn-signup {
    background: linear-gradient(135deg, #3b82f6, #1e40af);
    color: #ffffff;
    font-weight: 800;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
    margin-left: 25px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .btn-signup:hover {
    transform: translateY(-2px) scale(1.06);
    background: linear-gradient(135deg, #60a5fa, #2563eb); /* Brighter gradient on hover */
    box-shadow: 
      0 0 20px rgba(59, 130, 246, 0.6), 
      0 0 40px rgba(59, 130, 246, 0.4),
      0 0 60px rgba(59, 130, 246, 0.2); /* Deep Multi-layered Attractive Glow */
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
  }

  .btn-teacher {
    background: linear-gradient(135deg, #f43f5e, #e11d48);
    color: #ffffff;
    font-weight: 800;
    box-shadow: 0 0 25px rgba(244, 63, 94, .5);
    margin-left: 25px;
  }

  .btn-teacher:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 0 45px rgba(244, 63, 94, .75);
  }

  .logout-btn-icon {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--accent); /* Changed to use accent color */
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1.1rem;
  }

  .logout-btn-icon:hover {
    background: #f43f5e;
    color: #fff;
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(244, 63, 94, 0.4);
  }

  /* Hamburger icon (mobile only) */
  .menu-toggle {
    display: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .menu-toggle span {
    width: 24px;
    height: 2px;
    background: var(--accent);
    border-radius: 999px;
    transition: 0.2s ease;
  }

  /* when menu open add class .open to .menu-toggle */
  .menu-toggle.open span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.open span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ------------ RESPONSIVE ------------ */
  @media (max-width: 900px) {
    .navbar-custom {
      padding: 0 16px;
      height: auto;
      min-height: 70px;
    }

    .logo-area img {
      width: 54px;
      height: 54px;
    }

    .logo-text {
      font-size: 1.4rem;
    }

    .right-buttons {
      position: absolute;
      top: var(--nav-height);
      right: 0;
      left: 0;
      background: rgba(2, 6, 23, .96);
      border-top: 1px solid rgba(148, 163, 184, .25);
      padding: 12px 16px 14px;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      display: none;
      z-index: 15;
      backdrop-filter: blur(14px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, .75);
    }

    .right-buttons.show {
      display: flex;
    }

    .right-buttons a,
    .right-buttons button {
      margin-left: 0;
      width: 100%;
      text-align: left;
      padding: 10px 14px;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .logo-text {
      font-size: 1.25rem;
    }

    .logo-area img {
      width: 48px;
      height: 48px;
    }
  }
</style>

<nav class="navbar-custom">
  <div class="logo-area">
    <a href="/"><img src="/logo.png" alt="Logo"></a>
    <a href="/">
      <span class="logo-text">
        UniformCheck <span class="pro-text">Pro</span>
      </span>
    </a>
  </div>

  <!-- spacer -->
  <div style="flex:1;"></div>

  <!-- Hamburger for mobile -->
  <div class="menu-toggle" id="menuToggle" aria-label="Toggle navigation" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <!-- Right links -->
  <div class="right-buttons" id="rightButtons">
    <!-- Common Link -->
    <a href="/" class="nav-link-custom">Home</a>

    <% if (!currentUser) { %>
      <!-- GUEST VIEW -->
      <a href="/#about" class="nav-link-custom">About</a>
      <a href="/#workflow" class="nav-link-custom">Workflow</a>
      <a href="/#benefits" class="nav-link-custom">Benefits</a>
      
      <!-- Signup leads to combined /users/auth -->
      <a href="/users/auth?tab=signup" class="btn-signup">Signup</a>
      <a href="/users/teacher-login" class="btn-teacher">Teacher Login</a>

    <% } else if (userRole === 'student') { %>
      <!-- STUDENT VIEW -->
      <a href="/detect" class="nav-link-custom">Detect</a>
      <a href="/profile" class="nav-link-custom">Profile</a>
      
      <form action="/logout" method="post" style="display:inline; margin-left: 20px;">
        <button type="submit" class="logout-btn-icon" title="Logout">
          <i class="fa-solid fa-right-from-bracket"></i>
        </button>
      </form>

    <% } else if (userRole === 'teacher') { %>
      <!-- TEACHER VIEW -->
      <a href="/teacher/analytics" class="nav-link-custom">Analytics</a>
      <a href="/teacher/dashboard" class="btn-teacher">Teacher Dashboard</a>
      
      <form action="/logout" method="post" style="display:inline; margin-left: 20px;">
        <button type="submit" class="logout-btn-icon" title="Logout">
          <i class="fa-solid fa-right-from-bracket"></i>
        </button>
      </form>
    <% } %>
  </div>
</nav>

<script>
  // Simple mobile menu toggle
  const menuToggle = document.getElementById('menuToggle');
  const rightButtons = document.getElementById('rightButtons');

  if (menuToggle) {
    menuToggle.addEventListener('click', () => {
      const isOpen = rightButtons.classList.toggle('show');
      menuToggle.classList.toggle('open', isOpen);
      menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }
</script>
