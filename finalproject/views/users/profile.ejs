<%- include("../includes/boiler.ejs") %>
<%- include("../includes/nav.ejs") %>

<style>
  :root {
    --bg: #05060f;
    --card: rgba(255, 255, 255, 0.04);
    --border: rgba(255, 255, 255, 0.1);
    --muted: #94a3b8;
    --accent: #3b82f6;
  }

  .profile-container {
    max-width: 900px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .user-card {
    background: var(--card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .avatar {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--accent), #1e40af);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    font-weight: 800;
    color: #fff;
  }

  .user-info h1 { margin: 0; font-size: 24px; font-weight: 800; }
  .user-info p { margin: 5px 0 0; color: var(--muted); }

  .history-item {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-badge {
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
  }

  .compliant { background: rgba(34, 197, 94, 0.1); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
  .non-compliant { background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
</style>

<div class="profile-container">
  <div class="user-card">
    <div class="avatar"><%= currentUser.username.charAt(0).toUpperCase() %></div>
    <div class="user-info">
      <h1><%= currentUser.username %></h1>
      <p><%= currentUser.email %> • <%= currentUser.department %> Dept • <%= currentUser.year %><%= currentUser.year == 1 ? 'st' : currentUser.year == 2 ? 'nd' : 'rd' %> Year</p>
    </div>
  </div>

  <h2 style="font-weight: 800; margin-bottom: 20px;">Recent Detections</h2>
  <% if (history && history.length > 0) { %>
    <% history.forEach(h => { %>
      <div class="history-item">
        <div>
          <div style="font-weight: 700;"><%= h.label || 'Standard Scan' %></div>
          <div style="font-size: 12px; color: var(--muted); margin-top: 4px;"><%= new Date(h.createdAt).toLocaleString() %></div>
        </div>
        <div class="status-badge <%= h.isCompliant ? 'compliant' : 'non-compliant' %>">
          <%= h.isCompliant ? 'Compliant' : 'Violation' %> (<%= Math.round(h.confidence * 100) %>%)
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p style="color: var(--muted);">No scans recorded yet.</p>
  <% } %>
</div>

<%- include("../includes/footer.ejs") %>
